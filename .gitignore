# 个人学习进度 users/ 需要提交到 git，用于多电脑同步，不要忽略

# 临时文件
_tmp_pages/
_tmp_extract/
__pycache__/
*.pyc
_check.js
_smoke.js
_page_*.png
_t*.png
_p*.png

# App 打包（Capacitor）
# android/ 工程源码要提交（多电脑打包）；build/.gradle/local.properties 由 android/.gitignore 排除
# app/ 由 _build_app.py 生成，勿提交
# node_modules/ 用 npm install 恢复
node_modules/
/app/
*.apk

# 签名证书与 keystore.properties 要提交，换电脑才能继续打同签名包（覆盖安装不丢进度）
# 勿再忽略 *.keystore
